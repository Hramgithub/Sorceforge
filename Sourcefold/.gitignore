# Local runtime state
.env
.env.*
*.local
node_modules/

# Temporary work
tmp/
.tmp/
.pytest_cache/
*pytest*/

# Tracked contract tests
!tests/
!tests/**
tests/__pycache__/
tests/**/*.pyc

# Generated evidence that must be promoted deliberately
logs/
browser-profiles/
ocr-overlays/

# Secrets and credentials
*.pem
*.key
*.p12
*.pfx
credentials*
token*

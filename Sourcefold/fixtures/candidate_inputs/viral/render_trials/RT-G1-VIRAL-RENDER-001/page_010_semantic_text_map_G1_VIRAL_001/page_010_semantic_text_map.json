        "P010TR-G1-VIRAL-001"
      ],
      "text_source_state": "human_verified",
      "text": "US to bring him back. He is always looking at his phone and rejecting calls from them.",
      "heading_level": null,
      "display_style": "body",
      "source_role": "human_verified_span",
      "block_role": "text_column",

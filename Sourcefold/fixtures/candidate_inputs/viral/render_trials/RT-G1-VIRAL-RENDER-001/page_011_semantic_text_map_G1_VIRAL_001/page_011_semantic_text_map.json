      "font_style": "normal",
      "line_break_after": true
    },
    {
      "unit_id": "SU-P011-EMILY-002",
      "schema_version": "page_review_semantic_units.v1",
      "taxonomy_version": "sourcefold_page_review_taxonomy.v1",
      "unit_type": "paragraph",
      "unit_scope": "in_scope_text",
      "reading_order": 9,
      "source_region_ids": [
        "PRM-G1-VIRAL-001-P011-R04"

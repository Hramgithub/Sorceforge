      ],
      "text_source_state": "human_verified",
      "text": "Maya's Secrets",
      "heading_level": "h3",
      "display_style": "section_heading",
      "source_role": "human_verified_span",
      "block_role": "text_column",
      "source_block_id": "P011-B001",

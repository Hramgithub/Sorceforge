    },
    {
      "unit_id": "SU-P006-B003-S001",
      "schema_version": "page_review_semantic_units.v1",
      "taxonomy_version": "sourcefold_page_review_taxonomy.v1",
      "unit_type": "continuation",
      "unit_scope": "in_scope_text",
      "display_style": "body",

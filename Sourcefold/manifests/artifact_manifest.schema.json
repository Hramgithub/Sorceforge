{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nri.local/sourcefold/artifact_manifest.schema.json",
  "title": "Sourcefold Artifact Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "producing_stage",
    "created_at",
    "inputs",
    "outputs",
    "qa",
    "acceptance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "source_evidence",
        "accepted_source_text",
        "faithful_ru_draft",
        "proofread_ru_master",
        "press_projection",
        "bridge_export"
      ]
    },
    "producing_stage": {
      "type": "string",
      "enum": [
        "reconstruct",
        "translate",
        "proofread",
        "press",
        "bridge"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool_version"
      },
      "default": []
    },
    "model_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model_version"
      },
      "default": []
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_ref"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file_ref"
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "open_findings",
            "passed",
            "waived"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding_ref"
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "accepted_by": {
          "type": "string"
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "finding_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "waived"
          ]
        },
        "path": {
          "type": "string"
        }
      }
    },
    "tool_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "model_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "reasoning_effort": {
          "type": "string"
        }
      }
    }
  }
}

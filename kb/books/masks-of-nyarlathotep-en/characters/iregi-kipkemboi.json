  "abilities": [
    {
      "name": "Pulp Cthulhu: бой",
      "summary": "Драка 70% (35/14), урон 1d3+1d4 или панга 1d8+1d4; африканский метательный нож 30% (15/6), урон 1d4+2, плюс 1d4 рвущего урона при извлечении; Уклонение 50% (25/10).",
      "raw": "Brawl 70% (35/14), damage 1D3+1D4 or panga 1D8+1D4; African throwing knife 30% (15/6), damage 1D4+2, plus 1D4† ; Dodge 50% (25/10). † Tearing damage when removing the weapon; negated by a successful Medicine or Hard First Aid roll."
    },
    {
      "name": "Талант Pulp: Тяжёлая рука",
      "summary": "может потратить 10 Удачи, чтобы добавить ещё один кубик урона к атаке ближнего боя",
      "raw": "Heavy Hitter: may spend 10 Luck points to add an additional damage die when dealing out melee combat."
    }
  ],
  "description": {
    "ru": "Кениец, рядовой член Кровавого языка. Как и сообщники, носит потрёпанный костюм и отвратительный ритуальный головной убор культа — у низших членов вместо языка лишь полоска красной фланели; по-английски говорит плохо.",
    "en": null
  },
  "legend": {
    "ru": "Один из троих культистов, убивших Джексона Элайаса в номере 410 отеля «Челси»: все вооружены пангами — излюбленным оружием ритуальных убийств культа. Если сыщики ворвутся быстро, убийцы бросаются на них и бегут по пожарной лестнице к ждущему автомобилю; Иреги может унести бумаги Карлайла (Америка №1–3).",
    "en": null
  },

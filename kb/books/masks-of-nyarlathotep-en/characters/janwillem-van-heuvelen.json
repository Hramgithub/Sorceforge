  "abilities": [
    {
      "name": "Pulp Cthulhu: бой",
      "summary": "Ближний бой (драка) 45% (22/9), урон 1d3+1d4; Уклонение 40% (20/8)."
    },
    {
      "name": "Талант Pulp: Быстрое обучение (Quick Study)",
      "summary": "Вдвое сокращает время чтения книг — и Мифов, и обычных."

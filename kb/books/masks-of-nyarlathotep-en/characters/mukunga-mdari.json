  "abilities": [
    {
      "name": "Pulp Cthulhu: бой",
      "summary": "Драка 95% (47/19), урон 1d3+1d4, большой дубиной 1d8+1d4, львиными когтями 1d4+1d4, выкидным ножом 1d4+1d4; панга 85% (42/17), урон 1d8+1d4; африканский метательный нож 50% (25/10), урон 1d4+2, плюс 1d4 рвущего урона при извлечении; Уклонение 95% (47/19).",
      "raw": "Brawl 95% (47/19), damage 1D3+1D4 or large club 1D8+1D4, lion's claws 1D4+1D4, switchblade 1D4+1D4; Panga 85% (42/17), damage 1D8+1D4; African throwing knife 50% (25/10), damage 1D4+2, plus 1D4†; Dodge 95% (47/19)"
    },
    {
      "name": "Талант Pulp: Крепкий парень",
      "summary": "может потратить 10 Удачи, чтобы не получить до 5 пунктов урона за один раунд боя",
      "raw": "Tough Guy: may spend 10 Luck points to shrug off up to 5 hit points of damage taken in one combat round."

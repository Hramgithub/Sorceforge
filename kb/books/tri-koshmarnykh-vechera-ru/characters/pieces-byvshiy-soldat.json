  "background": {
    "traits": "Спокойный и надёжный, но громкие звуки пугают вас.",
    "ideology": "Друзья — это семья; мы заботимся друг о друге.",
    "treasured_possessions": "Пуля, которую доктор Уорвик извлёк из вас.",
    "injuries": "Ранение во Франции в Великую войну (пулю извлёк доктор Уорвик).",
    "significant_people": "Доктор Лоуренс Уорвик — давний друг."
  },
  "possessions": [
    "Автоматический пистолет .22 калибра",
    "Крем для обуви",

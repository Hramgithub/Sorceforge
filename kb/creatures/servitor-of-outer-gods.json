  "abilities": [
    {
      "name": "Музыка безумия",
      "summary": "Нестройная музыка служителя заставляет слушателей проверять рассудок каждые два раунда (0/1d4). Мудрые колдуны полагают, что потерявшие от неё рассудок сами могут стать служителями."
    },
    {
      "name": "Неуязвимость и регенерация",
      "summary": "Обычное оружие (включая пули) не наносит вреда; регенерирует 3 ПЗ за раунд, умирает при 0 ПЗ."
    },
    {
      "name": "Музыка призыва",
      "summary": "Явившись на Землю, служители иногда играют, помогая призывать тёмных существ и богов и обеспечивая успех ритуалов: их музыка несёт волны магической энергии."
    }
  ]

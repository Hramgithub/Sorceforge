  "rows": [
    {
      "roll": "1",
      "title": "Вы им должны",
      "text": "услугу, деньги, время?"
    },
    {
      "roll": "2",
      "title": "Они вам должны",
      "text": "услугу, деньги, время?"
    },
    {
      "roll": "3",
      "title": "Они вас чему-то научили",
      "text": "умению, жизненному уроку, увидеть свои ошибки?"
    },
    {
      "roll": "4",
      "title": "Они придают вашей жизни смысл",
      "text": "родитель, возлюбленный, партнёр, ребёнок?"
    },
    {
      "roll": "5",
      "title": "Вы их боготворите",
      "text": "за славу, дурную славу, красоту, богатство?"
    },
    {
      "roll": "6",
      "title": "Вы поступили с ними плохо и теперь чувствуете вину",
      "text": "что вы сделали?"
    },
    {
      "roll": "7",
      "title": "Они поступили с вами плохо и чувствуют вину",
      "text": "что они вам сделали?"
    },
    {
      "roll": "8",
      "title": "Вы жаждете мести",
      "text": "что они сделали, какой мести?"
    },
    {
      "roll": "9",
      "title": "Вы их презираете",
      "text": "задира, злобный, лучше вас?"
    },
    {
      "roll": "10",
      "title": "Вас что-то объединяет",
      "text": "пережитое, имущество, детство?"

  "rows": [
    {
      "roll": "1",
      "text": "Все меня подвели, так что я сам о себе позабочусь."
    },
    {
      "roll": "2",
      "text": "Не трогайте меня — я особенный."
    },
    {
      "roll": "3",
      "text": "Каждый хочет урвать кусок, и я возьму всё, что смогу."
    },
    {
      "roll": "4",
      "text": "Я никому не доверяю."
    },
    {
      "roll": "5",
      "text": "Надо верить, брат."
    },
    {
      "roll": "6",
      "text": "От работы ещё никто не умирал."
    },
    {
      "roll": "7",
      "text": "Нет высшей силы, чем истина."
    },
    {
      "roll": "8",
      "text": "Всё дело в общине, в том, чтобы работать вместе."
    },
    {
      "roll": "9",
      "text": "Моя судьба уже решена — я просто следую ей."
    },
    {
      "roll": "10",
      "text": "Без семьи и друзей я ничто."
    }
  ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcefold.local/schemas/character.schema.json",
  "title": "Персонаж",
  "description": "Человек или человекоподобный персонаж: NPC для Хранителя и/или готовый персонаж для игрока (§3.2). Статблок — общий шаблон с существами (Р-01).",
  "type": "object",
  "required": ["schema", "id", "kind", "name", "axes", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "sourcefold.character.v0" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "kind": { "const": "character" },
    "name": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Имя; у безымянного прегена — его обозначение («Торговец антиквариатом»), а в player_chooses есть name."
    },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["npc", "pregen"] },
      "description": "Как персонаж подан в источнике: npc — для Хранителя, pregen — готовый персонаж для игрока. Подсказка, а не ограничение: любой NPC может стать персонажем игрока и наоборот."
    },
    "stock_type": {
      "type": ["string", "null"],
      "description": "Типаж: типовой персонаж, а не конкретный человек (культист, полицейский). Не путать с архетипами Pulp Cthulhu."
    },
    "player_chooses": {
      "type": "array",
      "items": { "enum": ["name", "sex", "age", "luck", "skills", "background"] },
      "description": "Что игрок выбирает или бросает сам (у прегенов)."
    },
    "occupation": { "$ref": "common.schema.json#/$defs/text" },
    "occupation_ref": { "$ref": "common.schema.json#/$defs/id", "description": "Профессия из справочника kb/occupations (Р-46); `occupation` — как написано в источнике." },
    "age": { "$ref": "common.schema.json#/$defs/value" },
    "sex": { "type": ["string", "null"] },
    "residence": { "type": ["string", "null"] },
    "birthplace": { "type": ["string", "null"] },
    "axes": { "$ref": "common.schema.json#/$defs/axes" },
    "same_as": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
    "relations": { "$ref": "common.schema.json#/$defs/relations" },
    "statblock": { "$ref": "common.schema.json#/$defs/statblock" },
    "variants": {
      "type": "array",
      "description": "Групповой профиль (Р-74): несколько вариантов одного типажа из таблицы книги (1–8, A1–A5); основной statblock — первый вариант или общий профиль.",
      "items": {
        "type": "object",
        "required": ["label", "statblock"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "statblock": { "$ref": "common.schema.json#/$defs/statblock" }
        }
      }
    },
    "abilities": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ability" } },
    "background": {
      "type": "object",
      "description": "Характер и окружение по листу сыщика 7-й редакции (описание, убеждения, черты, значимые люди и места, ценности, травмы, фобии, тайные знания, встречи); всё — короткий русский текст. Биография — в legend.",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "ideology": { "type": "string" },
        "significant_people": { "type": "string" },
        "meaningful_locations": { "type": "string" },
        "treasured_possessions": { "type": "string" },
        "traits": { "type": "string" },
        "injuries": { "type": "string" },
        "phobias_manias": { "type": "string" },
        "arcane_tomes": { "type": "string" },
        "encounters": { "type": "string" },
        "secret": { "type": "string", "description": "Тайна персонажа — для Хранителя." }
      }
    },
    "possessions": { "type": "array", "items": { "type": "string" } },
    "wealth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spending_level": { "type": ["string", "null"] },
        "cash": { "type": ["string", "null"] },
        "assets": { "type": ["string", "null"] }
      }
    },
    "description": { "$ref": "common.schema.json#/$defs/text" },
    "legend": { "$ref": "common.schema.json#/$defs/legend" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source_ref" } },
    "errata": { "$ref": "common.schema.json#/$defs/errata" },
    "corrections": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/correction" } },
    "quality": { "$ref": "common.schema.json#/$defs/quality" }
  }
}

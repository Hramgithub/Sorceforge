{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcefold.local/schemas/handout.schema.json",
  "title": "Раздаточный материал",
  "description": "Текст, который Хранитель отдаёт игрокам: письмо, дневник, заметка (Р-128).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "name",
    "description",
    "axes",
    "sources",
    "handout_type"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sourcefold.handout.v0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "handout"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "handout_type": {
      "enum": [
        "письмо",
        "дневник",
        "газета",
        "документ",
        "записка",
        "прочее"
      ]
    },
    "text": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Текст для игроков (как в книге)."
    },
    "found_at": {
      "type": "array",
      "description": "Где его находят.",
      "items": {
        "type": "object",
        "required": [
          "location"
        ],
        "additionalProperties": false,
        "properties": {
          "location": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "leads_to": {
      "type": "array",
      "description": "К чему ведёт: места, персонажи, другие записи.",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "refs": {
      "type": "array",
      "description": "Связанные записи (персонажи, существа, места, книги, заклинания, другие сюжетные записи); просмотрщик показывает связь в обе стороны.",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "axes": {
      "$ref": "common.schema.json#/$defs/axes"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source_ref"
      }
    },
    "errata": {
      "$ref": "common.schema.json#/$defs/errata"
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/correction"
      }
    },
    "quality": {
      "$ref": "common.schema.json#/$defs/quality"
    }
  }
}

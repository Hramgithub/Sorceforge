{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcefold.local/schemas/item.schema.json",
  "title": "Предмет",
  "description": "Вещь, важная для игры: артефакт, улика, сюжетная вещь (Р-128).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "name",
    "description",
    "axes",
    "sources",
    "item_type"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "sourcefold.item.v0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "item"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "description": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "item_type": {
      "enum": [
        "артефакт",
        "улика",
        "вещь"
      ],
      "description": "артефакт — вещь Мифов или магическая; улика — ведёт к разгадке; вещь — прочее, важное для сюжета."
    },
    "found_at": {
      "type": "array",
      "description": "Где находится или где её можно найти.",
      "items": {
        "type": "object",
        "required": [
          "location"
        ],
        "additionalProperties": false,
        "properties": {
          "location": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "held_by": {
      "type": "array",
      "description": "У кого (владелец, хранитель); role — кто он для вещи.",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "mechanics": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Что даёт или чем грозит: проверки, потеря Рассудка, Мифы Ктулху, свойства."
    },
    "refs": {
      "type": "array",
      "description": "Связанные записи (персонажи, существа, места, книги, заклинания, другие сюжетные записи); просмотрщик показывает связь в обе стороны.",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "axes": {
      "$ref": "common.schema.json#/$defs/axes"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source_ref"
      }
    },
    "errata": {
      "$ref": "common.schema.json#/$defs/errata"
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/correction"
      }
    },
    "quality": {
      "$ref": "common.schema.json#/$defs/quality"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcefold.local/schemas/rule.schema.json",
  "title": "Правило",
  "description": "Запись справочника правил: одна тема (яды, утопление, другие виды урона…) — кратко, порядок действий, таблицы, примеры, источник (Р-175).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "name",
    "category",
    "summary",
    "axes",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "images": {
      "$ref": "common.schema.json#/$defs/images"
    },
    "schema": {
      "const": "sourcefold.rule.v0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "rule"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "aliases": {
      "type": "array",
      "description": "Другие названия темы: в книге, в других изданиях, в Foundry.",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "enum": [
        "создание сыщика",
        "проверки",
        "бой",
        "урон и здоровье",
        "рассудок",
        "погоня",
        "магия",
        "развитие",
        "расследование",
        "ведение игры",
        "артефакты",
        "прочее"
      ]
    },
    "optional": {
      "type": "boolean",
      "description": "Необязательное правило книги (в книге помечено «необязательное правило»)."
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Раздел книги, в который входит этот раздел (запись `rule` той же книги и главы); null — раздел верхнего уровня главы (Р-187)."
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Суть правила в одном-двух предложениях."
    },
    "text": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Правило полностью, как в книге (пересказ без потери механики)."
    },
    "steps": {
      "type": "array",
      "description": "Порядок действий за столом, по шагам — из текста книги.",
      "items": {
        "type": "string"
      }
    },
    "tables": {
      "type": "array",
      "description": "Таблицы правила (несколько столбцов); таблица с броском — отдельная запись `table` в refs.",
      "items": {
        "type": "object",
        "required": [
          "columns",
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "description": "Примеры игры из книги.",
      "items": {
        "type": "string"
      }
    },
    "refs": {
      "type": "array",
      "description": "Связанные записи (навыки, таблицы, другие правила, существа); просмотрщик показывает связь в обе стороны.",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "axes": {
      "$ref": "common.schema.json#/$defs/axes"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source_ref"
      }
    },
    "errata": {
      "$ref": "common.schema.json#/$defs/errata"
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/correction"
      }
    },
    "quality": {
      "$ref": "common.schema.json#/$defs/quality"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcefold.local/schemas/scenario.schema.json",
  "title": "Сценарий",
  "description": "Сценарий книги или его этап (цель рейда): всё, чтобы провести его без книги — фон для Хранителя, завязка, ход по шагам со ссылками на сцены, места, людей и раздаточные материалы, итог (Р-134). Этап ссылается на свой сценарий через part_of (Р-133).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "name",
    "summary",
    "axes",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "images": {
      "$ref": "common.schema.json#/$defs/images"
    },
    "schema": {
      "const": "sourcefold.scenario.v0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "scenario"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "part_of": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Сценарий, этапом которого является запись (цель рейда → «Рейд на Иннсмут»)."
    },
    "order": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Порядок в книге или внутри сценария."
    },
    "solo": {
      "type": "boolean",
      "description": "Соло-приключение (книга-игра с нумерованными абзацами): все абзацы целиком — в таблице «Абзацы» (№ — текст — переходы) в `tables`; персонажи, существа, места, предметы, карты и прегены — обычными записями (Р-230)."
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Коротко: о чём сценарий, для кого, сколько опасности."
    },
    "keeper_info": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Информация для Хранителя: что на самом деле происходит."
    },
    "hook": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Завязка: как сыщики втягиваются, что знают в начале."
    },
    "advice": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Советы Хранителю из книги (врезки)."
    },
    "steps": {
      "type": "array",
      "description": "Ход сценария по шагам; refs — сцены, места, люди, раздаточные материалы шага.",
      "items": {
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "optional": {
            "type": "boolean",
            "description": "Шаг случается не всегда (по условию или по выбору сыщиков)."
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            }
          }
        }
      }
    },
    "conclusion": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Итог: исходы, награды и потери Рассудка."
    },
    "tables": {
      "type": "array",
      "description": "Таблицы сценария по ходу игры. Таблица, которая нужна и вне сценария, хранится у города или места, а здесь на её месте — ссылка `from` + `title` (Р-136).",
      "items": {
        "anyOf": [
          {
            "$ref": "location.schema.json#/properties/tables/items"
          },
          {
            "type": "object",
            "required": [
              "from",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "title": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "axes": {
      "$ref": "common.schema.json#/$defs/axes"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source_ref"
      }
    },
    "errata": {
      "$ref": "common.schema.json#/$defs/errata"
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/correction"
      }
    },
    "quality": {
      "$ref": "common.schema.json#/$defs/quality"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sourcefold.local/schemas/talent.schema.json",
  "title": "Талант",
  "description": "Пульп-талант (Р-183): раздел и эффект; безумные таланты и таланты персонажей Хранителя — тоже таланты.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "kind",
    "name",
    "category",
    "description",
    "axes",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "images": {
      "$ref": "common.schema.json#/$defs/images"
    },
    "schema": {
      "const": "sourcefold.talent.v0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "talent"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "enum": [
        "физический",
        "ментальный",
        "боевой",
        "прочий",
        "безумный",
        "для персонажей Хранителя"
      ]
    },
    "description": {
      "$ref": "common.schema.json#/$defs/text",
      "description": "Что даёт талант — как в книге."
    },
    "cost": {
      "type": [
        "string",
        "null"
      ],
      "description": "Чем платят за применение (Удача, пункты магии…), если платят."
    },
    "refs": {
      "type": "array",
      "description": "Связанные записи; просмотрщик показывает связь в обе стороны.",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "axes": {
      "$ref": "common.schema.json#/$defs/axes"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source_ref"
      }
    },
    "errata": {
      "$ref": "common.schema.json#/$defs/errata"
    },
    "corrections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/correction"
      }
    },
    "quality": {
      "$ref": "common.schema.json#/$defs/quality"
    }
  }
}
